{
  "private": true,
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
  "repository": "https://github.com/TryGhost/NQL",
  "author": "Ghost Foundation",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "eslintIgnore": [
    "**/node_modules/**"
  ],
  "scripts": {
    "dev": "echo \"Implement me!\"",
    "build": "nx run-many -t build",
    "setup": "pnpm install",
    "test": "pnpm lint && pnpm nx run-many -t test",
    "lint": "nx run-many -t lint",
    "preship": "test \"$(git branch --show-current)\" = main && test -z \"$(git status --porcelain)\" || (echo \"Error: ship from a clean main branch\" && exit 1) && pnpm test",
    "ship": "nx release version --git-push --git-remote ${GHOST_UPSTREAM:-origin}",
    "test:ci": "pnpm lint && pnpm nx run-many -t test --outputStyle=static",
    "ship:patch": "pnpm ship patch",
    "ship:minor": "pnpm ship minor",
    "ship:major": "pnpm ship major"
  },
  "resolutions": {
    "underscore": "1.13.8"
  },
  "devDependencies": {
    "@nx/js": "23.3.1",
    "eslint": "10.14.0",
    "eslint-plugin-ghost": "4.0.1",
    "nx": "23.3.1"
  }
}
