{
  "private": true,
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "repository": "https://github.com/TryGhost/NQL",
  "author": "Ghost Foundation",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "eslintIgnore": [
    "**/node_modules/**"
  ],
  "scripts": {
    "dev": "echo \"Implement me!\"",
    "build": "nx run-many -t build",
    "setup": "pnpm install",
    "test": "pnpm test:tooling && pnpm lint && pnpm nx run-many -t test",
    "test:tooling": "node --test test/tooling.test.cjs",
    "lint": "nx run-many -t lint",
    "preship": "test \"$(git branch --show-current)\" = main && test -z \"$(git status --porcelain)\" || (echo \"Error: ship from a clean main branch\" && exit 1) && pnpm test",
    "ship": "nx release version --git-push --git-remote ${GHOST_UPSTREAM:-origin}",
    "test:ci": "pnpm test:tooling && pnpm lint && pnpm nx run-many -t test --outputStyle=static",
    "ship:patch": "pnpm ship patch",
    "ship:minor": "pnpm ship minor",
    "ship:major": "pnpm ship major"
  },
  "devDependencies": {
    "@nx/js": "24.0.7",
    "eslint": "8.57.1",
    "eslint-plugin-ghost": "4.0.1",
    "nx": "24.0.7"
  }
}

